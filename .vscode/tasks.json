{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/RawAccelProfiles/RawAccelProfiles.csproj",
        "-c",
        "Debug"
      ],
      "presentation": {
        "reveal": "always"
      },
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "clean",
      "type": "process",
      "command": "dotnet",
      "args": [
        "clean",
        "${workspaceFolder}/src/RawAccelProfiles/RawAccelProfiles.csproj"
      ],
      "presentation": {
        "reveal": "silent",
        "close": true
      }
    },
    {
      "label": "publish",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}/src/RawAccelProfiles/RawAccelProfiles.csproj",
        "-c",
        "Release"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build"
      }
    }
  ]
}
