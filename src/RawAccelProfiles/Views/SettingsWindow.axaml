<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RawAccelProfiles.ViewModels;assembly=RawAccelProfiles"
        mc:Ignorable="d"
        x:DataType="vm:SettingsViewModel"
        x:Class="RawAccelProfiles.Views.SettingsWindow"
        Title="Settings"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <!-- Same card styling as the Profile Editor page (Border Classes="card", 14,10 padding): each
       group is its own bordered box with a bold settings-section-header at 14px, matching that
       page's card headers, instead of plain text section breaks with no visual container. Gaps
       between cards come from this outer StackPanel's own Spacing, the same mechanism the
       Profile Editor uses between its cards, not a per-block Margin like the old floating-header
       layout needed. -->
  <StackPanel Margin="8" Spacing="8">

    <Border Classes="card" Padding="14,10">
      <StackPanel Spacing="8">
        <TextBlock Text="Folders" Classes="settings-section-header" />
        <StackPanel Spacing="8">
          <TextBlock Text="Raw Accel App Folder" />
          <StackPanel Orientation="Horizontal" Spacing="6"
                      ToolTip.Tip="Folder containing Raw Accel's rawaccel.exe, writer.exe, and settings.json.">
            <TextBox Width="420" Watermark="(default: app folder)" Text="{Binding RawAccelDirectory, Mode=TwoWay}" />
            <Button Content="Browse" Command="{Binding BrowseRawAccelDirCommand}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Spacing="8">
          <TextBlock Text="Raw Accel Presets Folder" />
          <StackPanel Orientation="Horizontal" Spacing="6"
                      ToolTip.Tip="Folder where Raw Accel template .json files are stored.">
            <TextBox Width="420" Watermark="(default: app folder)" Text="{Binding RawAccelSettingsDirectory, Mode=TwoWay}" />
            <Button Content="Browse" Command="{Binding BrowseRawAccelSettingsDirCommand}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" Padding="14,10">
      <StackPanel Spacing="8">
        <TextBlock Text="App Behavior" Classes="settings-section-header" />
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                    ToolTip.Tip="Launch RawAccelProfiles automatically when you log in to Windows.">
          <ToggleSwitch IsChecked="{Binding RunAtStartup, Mode=TwoWay}" />
          <TextBlock Text="Run At Startup" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                    ToolTip.Tip="Closing the main window minimizes it to the system tray instead of exiting the app.">
          <ToggleSwitch IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
          <TextBlock Text="Close to Tray" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                    ToolTip.Tip="Launch directly to the system tray instead of showing the main window.">
          <ToggleSwitch IsChecked="{Binding StartMinimized, Mode=TwoWay}" />
          <TextBlock Text="Start in Tray" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                    ToolTip.Tip="Re-apply the active profile's Raw Accel settings.json on launch, since Raw Accel's driver doesn't survive a reboot on its own.">
          <ToggleSwitch IsChecked="{Binding ApplyRawAccelSettingsOnStartup, Mode=TwoWay}" />
          <TextBlock Text="Apply Raw Accel Settings on Startup" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" Padding="14,10">
      <StackPanel Spacing="8">
        <!-- Order matches the Profile Editor page's own row order top-to-bottom (Y/X Ratio,
             EPP, EPP Override, Screen Size/Auto-Match Environment), not the order these
             toggles were added historically. -->
        <TextBlock Text="Advanced Profile Editor Options" Classes="settings-section-header" />
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                    ToolTip.Tip="Y/X Ratio lets Raw Accel scale vertical mouse sensitivity separately from horizontal.">
          <ToggleSwitch IsChecked="{Binding ShowYXRatio, Mode=TwoWay}" />
          <TextBlock Text="Show Y/X Ratio" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                    ToolTip.Tip="Enhance Pointer Precision (EPP) is Windows' own built-in mouse acceleration curve.">
          <ToggleSwitch IsChecked="{Binding ShowEpp, Mode=TwoWay}" />
          <TextBlock Text="Show EPP" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                    ToolTip.Tip="Replaces EPP acceleration with a flat, linear response. Same as the MarkC fix, but lets you pick a multiplier instead of using 1x. Requires relog.">
          <ToggleSwitch IsChecked="{Binding ShowEppOverride, Mode=TwoWay}" />
          <TextBlock Text="Show EPP Override" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                    ToolTip.Tip="Automatically adjusts your mouse sensitivity so it feels the same across profiles with different screen resolutions.">
          <ToggleSwitch IsChecked="{Binding ShowAutoMatchEnvironment, Mode=TwoWay}" />
          <TextBlock Text="Show Auto-Match Environment" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" Padding="14,10">
      <StackPanel Spacing="8">
        <TextBlock Text="Troubleshooting" Classes="settings-section-header" />
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Button Content="Apply MarkC Fix" Command="{Binding ApplyMarkCFixCommand}"
                  ToolTip.Tip="The MarkC fix replaces EPP acceleration with a 1:1 linear response. Requires relog." />
          <TextBlock Text="{Binding ApplyMarkCFixStatusMessage}"
                     IsVisible="{Binding IsApplyMarkCFixStatusVisible}"
                     FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Button Content="Reset Mouse Curve to Windows Default" Command="{Binding RevertCurveCommand}"
                  ToolTip.Tip="Restores EPP acceleration to stock settings. Requires relog." />
          <TextBlock Text="{Binding RevertCurveStatusMessage}"
                     IsVisible="{Binding IsRevertCurveStatusVisible}"
                     FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Same divider treatment as Target Manager's Cancel/Save row: a top border caps off the
         content above it, so the empty space to these buttons' left reads as a deliberate footer
         area instead of leftover space. -->
    <Border BorderBrush="{DynamicResource ThemeBorderMidBrush}"
            BorderThickness="0,1,0,0"
            Padding="0,8,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Classes="dialog-action" Content="Cancel" Command="{Binding CancelCommand}" />
        <Button Classes="dialog-action" Content="Save" Command="{Binding SaveCommand}" IsDefault="True" />
      </StackPanel>
    </Border>

  </StackPanel>

</Window>
