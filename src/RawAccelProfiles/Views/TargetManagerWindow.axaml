<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RawAccelProfiles.ViewModels;assembly=RawAccelProfiles"
        xmlns:models="clr-namespace:RawAccelProfiles.Models;assembly=RawAccelProfiles"
        mc:Ignorable="d"
        x:DataType="vm:TargetManagerViewModel"
        x:Class="RawAccelProfiles.Views.TargetManagerWindow"
        Title="App Rules Manager"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

  <!-- Width, Height, and MinHeight are deliberately not set here: TargetManagerWindow.axaml.cs's
       constructor computes and sets all three, from real measured content, before this window is
       ever shown. Declaring placeholder values here would just be dead code; they'd be
       overwritten before the first frame ever renders. -->
  <Grid RowDefinitions="*,Auto" Margin="12" >

    <!-- ════ Main 3-column pane ════ -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*" Margin="0,0,0,10">

      <!-- LEFT: Active Window Discovery -->
      <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="6">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Active Windows" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Content="Refresh"
                  Command="{Binding RefreshWindowsCommand}"
                  Padding="8,3" />
        </StackPanel>

        <Border Grid.Row="1"
                Classes="card"
                ClipToBounds="True">
          <ListBox ItemsSource="{Binding ActiveWindows}"
                   SelectedItem="{Binding SelectedWindow, Mode=TwoWay}"
                   Background="Transparent"
                   BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Margin" Value="3,1" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:WindowEntry">
                <Grid ColumnDefinitions="6,*" Margin="0,2">
                  <!-- Green match bar — only visible after Test Match -->
                  <Border Grid.Column="0"
                          Background="{DynamicResource MatchIndicatorBrush}"
                          IsVisible="{Binding IsMatched}"
                          Margin="0,2,5,2"
                          CornerRadius="0" />
                  <StackPanel Grid.Column="1"
                              ToolTip.Tip="{Binding DetailTooltip}">
                    <TextBlock Text="{Binding ExeName}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding TitleDisplay}"
                               FontSize="11"
                               Opacity="0.7"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Grid>

      <!-- CENTER: Action buttons -->
      <!-- Row 0 is an invisible spacer matching the left/right columns' own header row (the
           "Active Windows"/"Refresh" row); copies that row's real markup instead of a guessed
           pixel height, so it can't drift out of sync if that row's content ever changes.
           Opacity="0" (not IsVisible) so it still reserves its layout space; IsHitTestVisible
           ="False" so it can't intercept clicks. Without this, CenterButtons centered across the
           *entire* column height including this header space, pushing the buttons up above where
           the lists visually start; found live, from a screenshot showing the button stack
           reaching the very top of the window instead of stopping level with the lists. -->
      <Grid x:Name="CenterColumn" Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="6" Margin="12,0">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Opacity="0" IsHitTestVisible="False">
          <TextBlock Text="Active Windows" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Content="Refresh" Padding="8,3" />
        </StackPanel>

        <StackPanel x:Name="CenterButtons" Grid.Row="1" VerticalAlignment="Center" Spacing="8">
          <Button Content="→ Add as EXE"
                  Command="{Binding AddAsExeCommand}"
                  HorizontalAlignment="Stretch"
                  Padding="10,6" />
          <Button Content="→ Add as Path"
                  Command="{Binding AddAsPathCommand}"
                  HorizontalAlignment="Stretch"
                  Padding="10,6" />
          <Button Content="→ Add as Class"
                  Command="{Binding AddAsClassCommand}"
                  HorizontalAlignment="Stretch"
                  Padding="10,6" />
          <Button Content="→ Add as Title"
                  Command="{Binding AddAsTitleCommand}"
                  HorizontalAlignment="Stretch"
                  Padding="10,6" />
        </StackPanel>
      </Grid>

      <!-- RIGHT: Current Associations -->
      <!-- MatchSummary lives inline in the header row now, not a separate bottom row: an
           earlier attempt at inline placement overflowed the window because the message could be
           a long sentence ("No open windows match the current associations."). Now that every
           case uses the same short "N matched." format, that risk is gone, so both panels can go
           back to the plain Auto,* they'd have without any of this MatchSummary history. -->
      <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="6">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
          <TextBlock Text="App Rules" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Content="Test"
                  Command="{Binding TestMatchCommand}"
                  Padding="8,3"
                  ToolTip.Tip="Highlight which open windows these rules would match" />
          <TextBlock Text="{Binding MatchSummary}"
                     FontSize="11"
                     Opacity="0.75"
                     VerticalAlignment="Center"
                     IsVisible="{Binding MatchSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <Border Grid.Row="1"
                Classes="card"
                ClipToBounds="True">
          <ListBox ItemsSource="{Binding Associations}"
                   Background="Transparent"
                   BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Margin" Value="3,1" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:TargetAssociation">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,2">
                  <!-- Type badge -->
                  <Border Grid.Column="0"
                          Background="{DynamicResource ThemeControlMidBrush}"
                          CornerRadius="0"
                          Padding="5,2"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding TypeLabel}"
                               FontSize="10"
                               FontWeight="Bold" />
                  </Border>

                  <!-- Value -->
                  <TextBlock Grid.Column="1"
                             Text="{Binding Value}"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Value}" />

                  <!-- Delete -->
                  <Button Grid.Column="2"
                          Padding="6,2"
                          Margin="6,0,0,0"
                          VerticalAlignment="Center"
                          Command="{Binding $parent[Window].((vm:TargetManagerViewModel)DataContext).RemoveCommand}"
                          CommandParameter="{Binding}">
                    <TextBlock Classes="icon-glyph" Text="&#xE711;" FontSize="12" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Grid>
    </Grid>

    <!-- ════ Manual entry + Save / Cancel ════ -->
    <Border x:Name="BottomRowContainer"
            Grid.Row="1"
            BorderBrush="{DynamicResource ThemeBorderMidBrush}"
            BorderThickness="0,1,0,0"
            Padding="0,8,0,0">
      <Grid x:Name="BottomRow" ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Manual:" VerticalAlignment="Center" Opacity="0.7" />
          <ComboBox ItemsSource="{Binding MatchTypeOptions}"
                    SelectedItem="{Binding SelectedManualType, Mode=TwoWay}"
                    Width="110" />
          <TextBox Text="{Binding ManualValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Width="280" />
          <Button Classes="dialog-action" Content="Add" Command="{Binding AddManualCommand}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="dialog-action" Content="Cancel" Command="{Binding CancelCommand}" />
          <Button Classes="dialog-action" Content="Save" Command="{Binding SaveCommand}" IsDefault="True" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
