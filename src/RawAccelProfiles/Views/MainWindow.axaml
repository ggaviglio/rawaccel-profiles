<!-- MinHeight="167" lets the window shrink down to roughly just the Raw Accel card, since
     someone who only cares about Settings/Sensitivity/Y-X Ratio shouldn't be forced to keep the
     whole profile list and every other card on screen. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RawAccelProfiles.ViewModels"
        xmlns:views="using:RawAccelProfiles.Views"
        xmlns:models="using:RawAccelProfiles.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        Width="732"
        Height="400"
        MinHeight="167"
        MinWidth="732"
        x:Class="RawAccelProfiles.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Raw Accel Profiles">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid x:Name="RootLayout">
        <Grid.ColumnDefinitions>
            <!-- The sidebar column's MinWidth is assigned in code-behind, from the action bar's
                 own measured natural width (see MainWindow.axaml.cs). It can't be declared here:
                 x:Name on a ColumnDefinition generates no code-behind field (it isn't a Control),
                 so RootLayout is named instead and the column reached through its collection.
                 A "*" column splits whatever the Auto content column leaves over, so without that
                 floor the sidebar is the side that absorbs every squeeze. -->
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border x:Name="SidebarHost" Grid.Column="0" Background="{DynamicResource ThemeBackgroundBrush}" Padding="8,8,4,8"
                UseLayoutRounding="False">
            <Grid RowDefinitions="*,Auto">

                <!-- Row 0: All profiles -->
                <!-- Search box and list are no longer inside one shared card: the list's own
                     ListBox.Styles/ItemTemplate below is unchanged, only which Border wraps it
                     changed. Sharing one card previously meant the ListBox's scrollbar only
                     spanned its own row (below the search box), so it reached the card's
                     bottom-right corner cleanly but stopped short of the top-right corner,
                     found live via screenshot. Giving the list its own dedicated card fixes that,
                     and the search box's own Margin gives it a real visible gap above the list
                     instead of relying on the shared card's internal row spacing for separation. -->
                <Grid Grid.Row="0" RowDefinitions="Auto,*">
                    <TextBox Grid.Row="0"
                             Text="{Binding SearchText, Mode=TwoWay}"
                             Watermark="Search profiles..."
                             Margin="0,0,0,8" />
                    <Border Grid.Row="1"
                            Classes="card"
                            ClipToBounds="True"
                            Padding="0">
                        <ListBox ItemsSource="{Binding FilteredProfiles}"
                             SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="CornerRadius" Value="0" />
                                <Setter Property="Margin" Value="3,1" />
                                <Setter Property="Padding" Value="6,3" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:MouseProfile">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*" Margin="0">
                                <!-- Active indicator dot -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding AutoSwitchEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          ToolTip.Tip="Enable automatic profile switching for this profile"
                                          Margin="0,0,6,0" />
                                <!-- Active/Default markers grouped together after the checkbox
                                     (the row's one interactive control), instead of split apart
                                     by it, since both are passive status glyphs, so keeping them
                                     adjacent reads as one cluster instead of alternating between
                                     control and indicator. -->
                                <Ellipse Grid.Column="1"
                                         Width="8" Height="8"
                                         Fill="{DynamicResource MatchIndicatorBrush}"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding IsActive}" />
                                <!-- Default marker: placed before the name (not after) so it can't
                                     get squeezed out by truncation the way a trailing marker
                                     could. Replaces the old FontWeight-based marker, which was
                                     confirmed too subtle in this font at this size (same issue
                                     already found for the Settings window's section headers).
                                     Reuses the same home glyph already on the "Set as Default"
                                     button rather than a text badge, since a wider badge would
                                     put more pressure on the name needing to truncate in this
                                     already-tight row. -->
                                <TextBlock Grid.Column="2"
                                           Classes="icon-glyph"
                                           Text="&#xE80F;"
                                           Margin="0,0,6,0"
                                           IsVisible="{Binding IsDefault}"
                                           ToolTip.Tip="Default profile" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding ProfileName}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Stretch"
                                           Background="Transparent"
                                           MinHeight="16"
                                           Padding="0,2"
                                           IsVisible="{Binding !IsEditing}"
                                           DoubleTapped="ProfileName_DoubleTapped" />
                                <TextBox Grid.Column="3"
                                         Text="{Binding ProfileName, Mode=TwoWay}"
                                         IsVisible="{Binding IsEditing}"
                                         Padding="2,4"
                                         VerticalContentAlignment="Center"
                                         VerticalAlignment="Center"
                                         Loaded="ProfileNameEdit_Loaded"
                                         KeyDown="ProfileNameEdit_KeyDown"
                                         LostFocus="ProfileNameEdit_LostFocus" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                    </Border>
                </Grid>

                <!-- Row 1: Action bar -->
                <!-- UseLayoutRounding=False: MinWidth reserves the editor's scrollbar width even when
                     no scrollbar is showing, so those spare pixels land in the sidebar and do not
                     divide evenly by 8. Layout rounding snapped some columns up and others down,
                     making the buttons visibly uneven at small widths; letting them take
                     fractional widths keeps all eight identical. -->
                <Grid x:Name="ActionBar" Grid.Row="1" Margin="0,8,0,0"
                      ColumnDefinitions="*,*,*,*,*,*,*,*" ColumnSpacing="6">
                    <Grid.Styles>
                        <Style Selector="Button">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="Height" Value="28" />
                            <Setter Property="MinWidth" Value="28" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </Grid.Styles>
                    <Button Grid.Column="0"
                            ToolTip.Tip="Apply selected profile"
                            Command="{Binding ApplySelectedCommand}">
                        <TextBlock Classes="icon-glyph" Text="&#xE768;" FontSize="14" />
                    </Button>
                    <Button Grid.Column="1"
                            ToolTip.Tip="Set as Default — the baseline every other profile compensates against."
                            Command="{Binding SetAsDefaultCommand}">
                        <TextBlock Classes="icon-glyph" Text="&#xE80F;" FontSize="14" />
                    </Button>
                    <Button Grid.Column="2"
                            ToolTip.Tip="Clone selected profile"
                            Command="{Binding CloneProfileCommand}">
                        <TextBlock Classes="icon-glyph" Text="&#xE8C8;" FontSize="14" />
                    </Button>
                    <Button Grid.Column="3"
                            ToolTip.Tip="Add profile"
                            Command="{Binding AddProfileCommand}">
                        <TextBlock Classes="icon-glyph" Text="&#xE710;" FontSize="14" />
                    </Button>
                    <Button Grid.Column="4"
                            ToolTip.Tip="Delete selected profile"
                            Command="{Binding DeleteProfileCommand}">
                        <TextBlock Classes="icon-glyph" Text="&#xE738;" FontSize="14" />
                    </Button>
                    <Button Grid.Column="5"
                            ToolTip.Tip="Move selected profile up"
                            Command="{Binding MoveProfileUpCommand}">
                        <TextBlock Classes="icon-glyph" Text="&#xE74A;" FontSize="14" />
                    </Button>
                    <Button Grid.Column="6"
                            ToolTip.Tip="Move selected profile down"
                            Command="{Binding MoveProfileDownCommand}">
                        <TextBlock Classes="icon-glyph" Text="&#xE74B;" FontSize="14" />
                    </Button>
                    <Button Grid.Column="7"
                            ToolTip.Tip="Global Settings"
                            Command="{Binding OpenSettingsCommand}">
                        <TextBlock Classes="icon-glyph" Text="&#xE713;" FontSize="16" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Border x:Name="MainContentHost" Grid.Column="1" Padding="4,8,8,8">
            <views:ProfileEditorView DataContext="{Binding ProfileEditor}" />
        </Border>
    </Grid>

</Window>
