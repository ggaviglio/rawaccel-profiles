<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RawAccelProfiles.ViewModels;assembly=RawAccelProfiles"
             xmlns:models="clr-namespace:RawAccelProfiles.Models;assembly=RawAccelProfiles"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:converters="clr-namespace:RawAccelProfiles.Converters;assembly=RawAccelProfiles"
             x:DataType="vm:ProfileEditorViewModel"
             mc:Ignorable="d"
             x:Class="RawAccelProfiles.Views.ProfileEditorView">

  <UserControl.Resources>
    <converters:WinPointerSpeedDisplayConverter x:Key="WinPointerSpeedDisplayConverter" />
    <converters:NullableBoolDisplayConverter x:Key="NullableBoolDisplayConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="ComboBox.editable-centered /template/ TextBox#PART_EditableTextBox">
      <Setter Property="Padding" Value="8,0,0,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <!-- SimpleTheme's ComboBox only shows PlaceholderText when !IsEditable (confirmed against
           Avalonia's source, v11.3.12); these two are IsEditable="True", so their own
           PlaceholderText="Skip" never rendered. PART_EditableTextBox is a real TextBox, so its
           native Watermark works normally; set directly here instead since both instances of
           this class want the same literal text. -->
      <Setter Property="Watermark" Value="Skip" />
    </Style>
    <!-- SimpleTheme's own ComboBox.xaml only styles BorderBrush for :pointerover, never :focus
         (confirmed against Avalonia's source, v11.3.12) — unlike TextBox.xaml, which styles both
         with the same ThemeBorderHighBrush. That's why Screen Width/Scale only highlighted on
         hover while Sensitivity/RegistryCurveOverride also highlighted on focus: different
         control types (ComboBox vs TextBox), and only one of the two has focus styling at all in
         the theme itself. :focus-within (not :focus) because focus actually lands on the
         editable ComboBox's internal PART_EditableTextBox, not the ComboBox itself. Reuses the
         theme's own ThemeBorderHighBrush so this matches its hover color exactly instead of
         introducing a new one. -->
    <Style Selector="ComboBox.editable-centered:focus-within /template/ Border#border">
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderHighBrush}" />
    </Style>
    <Style Selector="Button.icon-btn">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ToggleButton.auto-toggle">
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <!-- Shared width for Raw Accel's Settings/Sensitivity boxes and Windows Pointer's EPP
         Override box, so the three stay in sync as one group instead of three independently
         hardcoded Width values that can silently drift apart. Two selectors (ComboBox + TextBox)
         under one class name since Settings is a ComboBox and Sensitivity/EPP Override are
         TextBoxes. -->
    <Style Selector="ComboBox.value-box">
      <Setter Property="Width" Value="166" />
    </Style>
    <Style Selector="TextBox.value-box">
      <Setter Property="Width" Value="166" />
    </Style>
    <Style Selector="TextBlock.match-percent">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Toggled via IsVisible="{Binding !IsXxxInputValid}": rejected keystrokes (e.g. a typed
         negative number) are never applied to the real value, but previously gave no visual
         sign that anything was rejected. This is display-only: it never changes what gets
         applied, only whether the mismatch between the box and the real value is visible.
         A separate overlaid glyph rather than styling BorderBrush directly on the TextBox/
         ComboBox — confirmed live that the theme's own state styling (:focus for TextBox,
         :pointerover for ComboBox) silently wins over a border set via a class selector, so the
         red border only appeared sometimes (e.g. it vanished on hover), which looked more broken
         than having no indicator at all. An overlay isn't part of either control's own template,
         so no theme-internal state styling can hide it. IsHitTestVisible="False" so it never
         intercepts clicks/typing meant for the field underneath it. Margin is set per-instance,
         not here, since the two ComboBoxes need extra right-margin to clear their own built-in
         dropdown arrow — a shared value here would either overlap the arrow or sit too far left
         on the plain TextBoxes that don't have one. -->
    <Style Selector="TextBlock.input-error-icon">
      <Setter Property="Text" Value="⚠" />
      <Setter Property="Foreground" Value="#E5484D" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <!-- "Settings"/"Context" group headers as their own bounded bar, not floating text: a plain
         TextBlock (tried first, twice, at two different font sizes) never read as a real section
         header no matter how it was sized relative to the cards below it; it was competing with
         "Raw Accel"/"Windows Pointer" on typography alone instead of being a genuinely distinct UI
         element; a filled/bordered bar, full card-width, doesn't need to win on font size, it wins
         by being its own visible object, the same way a labeled section bar reads in most settings
         UIs (a title row sitting above a group, not a caption floating in whitespace). Background
         uses ThemeControlMidBrush, the same brush this file already uses for the small type-label
         badges, so it reads as "a filled UI chrome element" rather than introducing a new color. -->
    <!-- Height="28" matches the sidebar search box's own live-measured rendered height
         (confirmed via a temporary debug print of SearchBox.Bounds.Height, not a guess), so the
         two boxes now top-align across the sidebar/content split the same way the search box
         and profile list card already do. Padding drops to horizontal-only since a fixed Height
         plus top/bottom padding would just fight each other; vertical centering instead comes
         from the TextBlock's own VerticalAlignment below, the same "wrap the fixed-height element,
         center the child" pattern already used elsewhere in this app (a fixed-Height element
         can't center its own text via its own VerticalAlignment). -->
    <Style Selector="Border.group-header-bar">
      <Setter Property="Background" Value="{DynamicResource ThemeControlMidBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMidBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.group-header-bar TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>


  <ScrollViewer Margin="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <!-- RowSpacing intentionally not used here: it adds a gap structurally, between every row
         slot, regardless of whether either side is actually visible. Card 3 (Auto-Match
         Environment) is hidden by default, and RowSpacing left both its gaps behind even while
         collapsed. Margin belongs to the element itself, so it disappears along with it. -->
    <Grid RowDefinitions="Auto,*">
      <!-- Cards 1-3 share a "CardWidth" column, in their own nested IsSharedSizeScope, so they
           auto-size to the widest one (the Raw Accel card's icon row) instead of a hand-measured
           hardcoded Width, the same SharedSizeGroup trick as "LabelCol" below, just for the
           outer card width instead of the inner label column. Card 4 (Target Associations) is
           deliberately NOT a member of this scope: its target-value text is arbitrary user data
           (file paths, window titles) with no fixed upper bound, and joining the scope directly
           creates a real feedback loop with its own Width binding below (confirmed live: it grew
           on an overflow value and then never shrank back down after the value was fixed, because
           it was both contributing to and consuming from the same shared measurement). Nesting it
           has to be a genuinely separate Grid, not just an explicit Width on a same-scope cell,
           since an explicit Width still counts as that cell's contribution to the shared max. -->
      <!-- Two labeled groups within one shared-sizing scope: "Settings" (Raw Accel, Windows
           Pointer, the only two cards that actually write real state to the system) and
           "Context" (Auto-Match Environment, Target Associations, inputs the math/matching
           consumes, not applied directly). Context sits second/last specifically so Target
           Associations, the one card whose content can actually grow, ends up in the page's
           growable bottom slot; the others have fixed-size content that wouldn't use extra room
           anyway. Trade-off, accepted deliberately: this reverses the previous "cause before
           effect" ordering (Auto-Match Environment's Screen Width/Scale used to read before the
           Auto-sync buttons that consume them); the growable-space win was judged worth it. -->
      <Grid Grid.Row="0" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Grid.IsSharedSizeScope="True">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="CardWidth" />
        </Grid.ColumnDefinitions>

        <!-- Deliberately NOT height-matched to the sidebar's search box: tried, then reverted,
             since matching the box height didn't make it look aligned, given "Search profiles..."
             is a bordered box and this is bare text with nothing around it. Same class as the
             "Context" bar below (see Style Selector="Border.group-header-bar" above for why
             it's its own class, not the shared "settings-section-header"). -->
        <Border Grid.Row="0" Classes="group-header-bar">
          <TextBlock Text="Settings" />
        </Border>

            <!-- ═══ Card 2: Raw Accel ═══ -->
            <Border x:Name="RawAccelCard" Grid.Row="1" Classes="card" Padding="14,10" Margin="0,0,0,8">
        <!-- Column 0 joins the "LabelCol" SharedSizeGroup (also used by Card 3, Windows Pointer,
             directly below): unlike the earlier Screen Width case, these two cards are adjacent
             and each has multiple real label rows, so syncing their label column widths creates
             an actual visible aligned column across both cards instead of accidental coupling. -->
        <Grid RowDefinitions="Auto,Auto,Auto,Auto">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <!-- Header -->
          <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                     Text="Raw Accel" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />

          <!-- Settings row -->
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Settings:" VerticalAlignment="Center" Margin="0,0,10,6" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
            <ComboBox Classes="value-box" ItemsSource="{Binding RawAccelSettingsFiles}" SelectedItem="{Binding SelectedRawAccelSettingsFile, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding ., TargetNullValue=(Skip)}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Classes="icon-btn"
                    Command="{Binding OpenRawAccelGuiCommand}"
                    ToolTip.Tip="Open the Raw Accel GUI (rawaccel.exe)">
              <TextBlock Classes="icon-glyph" Text="&#xE90F;" FontSize="14" />
            </Button>
            <Button Classes="icon-btn"
                    Command="{Binding ImportCurrentSettingsCommand}"
                    ToolTip.Tip="Import current Raw Accel settings.json as a new preset">
              <TextBlock Classes="icon-glyph" Text="&#xE896;" FontSize="14" />
            </Button>
            <Button Classes="icon-btn"
                    Command="{Binding DuplicateRawAccelSettingsCommand}"
                    ToolTip.Tip="Duplicate selected settings file under a new name">
              <TextBlock Classes="icon-glyph" Text="&#xE8C8;" FontSize="14" />
            </Button>
            <Button Classes="icon-btn"
                    Command="{Binding RenameRawAccelSettingsCommand}"
                    ToolTip.Tip="Rename selected settings file (updates any profiles that reference it)">
              <TextBlock Classes="icon-glyph" Text="&#xE70F;" FontSize="14" />
            </Button>
            <Button Classes="icon-btn"
                    Command="{Binding DeleteRawAccelSettingsCommand}"
                    ToolTip.Tip="Delete selected preset">
              <TextBlock Classes="icon-glyph" Text="&#xE74D;" FontSize="14" />
            </Button>
          </StackPanel>

          <!-- Sensitivity row -->

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Sensitivity:" VerticalAlignment="Center" Margin="0,0,10,6" />
          <!-- Sensitivity row with Auto and Match % right-aligned -->
          <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,6" VerticalAlignment="Center">
            <TextBox Grid.Column="0" Classes="value-box"
                     Text="{Binding SensitivityString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Watermark="Skip"
                     IsEnabled="{Binding !IsRawAutoSync}"
                     ToolTip.Tip="Raw Accel sensitivity multiplier." />
            <TextBlock Grid.Column="0" Classes="input-error-icon" Margin="0,0,6,0"
                       IsVisible="{Binding !IsSensitivityInputValid}"
                       ToolTip.Tip="Rejected — must be a positive number, at most 15 significant digits." />
            <ToggleButton Grid.Column="1"
                          IsChecked="{Binding IsRawAutoSync, Mode=TwoWay}"
                          Content="Auto" Classes="auto-toggle"
                          IsVisible="{Binding IsRawAutoAvailable}"
                          ToolTip.Tip="Automatically adjust Sensitivity to match the Default profile." />
            <TextBlock Grid.Column="2"
                       Classes="match-percent"
                       IsVisible="{Binding !IsDefault}"
                       Text="{Binding RawAccelMatchAccuracy}"
                       ToolTip.Tip="{Binding RawAccelMatchAccuracy}" />
          </Grid>

          <!-- Y/X Ratio row -->
          <!-- Advanced option, gated on its own IsYXRatioVisible (ShowAutoMatchEnvironment AND
               ShowYXRatio both on) so it can be hidden independently of Screen Width/Height,
               same relationship as EPP Override to the base EPP row, unlike Sensitivity above (whose
               field stays relevant regardless of Auto-Match Environment). Right-aligned value
               bound to YXRatioMatch, NOT YXRatioString, in the match-percent slot, same
               layout rhythm as the other rows: a live comparison against what the aspect-ratio
               mismatch actually needs (1.0 = fully compensated), not a second copy of whatever
               the textbox already shows. Found live: binding this slot to YXRatioString just
               mirrored the textbox, so Skip mode (blank textbox, the default for every profile)
               showed nothing here even when a real, uncorrected mismatch existed. -->
          <TextBlock Grid.Row="3" Grid.Column="0" Text="Y/X Ratio:" VerticalAlignment="Center" Margin="0,0,10,6"
                     IsVisible="{Binding IsYXRatioVisible}" />
          <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,6" VerticalAlignment="Center"
                IsVisible="{Binding IsYXRatioVisible}">
            <TextBox Grid.Column="0" Classes="value-box"
                     Text="{Binding YXRatioString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Watermark="Skip"
                     IsEnabled="{Binding !IsYXRatioAutoSync}"
                     ToolTip.Tip="Y/X sensitivity ratio (vertical sens multiplier)." />
            <TextBlock Grid.Column="0" Classes="input-error-icon" Margin="0,0,6,0"
                       IsVisible="{Binding !IsYXRatioInputValid}"
                       ToolTip.Tip="Rejected — must be a positive number, at most 15 significant digits." />
            <ToggleButton Grid.Column="1"
                          IsChecked="{Binding IsYXRatioAutoSync, Mode=TwoWay}"
                          Content="Auto" Classes="auto-toggle"
                          IsVisible="{Binding IsYXRatioAutoAvailable}"
                          ToolTip.Tip="Auto-compute the Y/X ratio from this profile's Screen Width/Height vs. the Default's aspect ratio." />
            <TextBlock Grid.Column="2"
                       Classes="match-percent"
                       IsVisible="{Binding IsYXRatioAutoAvailable}"
                       Text="{Binding YXRatioMatch}"
                       ToolTip.Tip="How well the currently effective Y/X ratio compensates for this profile's aspect-ratio mismatch. 1.0 = fully compensated." />
          </Grid>
        </Grid>
      </Border>

            <!-- ═══ Card 3: Windows Pointer ═══ -->
            <Border Grid.Row="2" Classes="card" Padding="14,10" Margin="0,0,0,8">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                     Text="Windows Pointer" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Pointer Speed:" VerticalAlignment="Center" Margin="0,0,10,6" />

          <!-- Pointer Speed row with Auto and Match % right-aligned -->
          <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,6" VerticalAlignment="Center">
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding WinPointerOptions}" SelectedItem="{Binding WinPointerSpeed, Mode=TwoWay}"
                      MinWidth="125" IsEnabled="{Binding !IsOSAutoSync}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding ., Converter={StaticResource WinPointerSpeedDisplayConverter}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <ToggleButton Grid.Column="1"
                          IsChecked="{Binding IsOSAutoSync, Mode=TwoWay}"
                          Content="Auto" Classes="auto-toggle"
                          IsVisible="{Binding IsAutoSyncAvailable}"
                          ToolTip.Tip="Automatically adjust Windows Pointer Speed to match the Default profile." />
            <TextBlock Grid.Column="2"
                       Classes="match-percent"
                       IsVisible="{Binding !IsDefault}"
                       Text="{Binding WinSpeedMatchAccuracy}"
                       ToolTip.Tip="{Binding WinSpeedMatchAccuracy}" />
          </Grid>

          <!-- EPP dropdown: Skip / Enable / Disable -->
          <!-- Advanced option, hidden by default (Settings > Show EPP), see AppSettings.ShowEpp.
               Label and content are separate sibling elements sharing this Grid.Row (not one
               container), so both need the binding for the row to actually collapse instead of
               leaving the label behind, same pattern as the EPP Override row below. -->
          <TextBlock Grid.Row="2" Grid.Column="0" Text="EPP:" VerticalAlignment="Center" Margin="0,0,10,6"
                     IsVisible="{Binding IsEppVisible}" />
          <ComboBox Grid.Row="2" Grid.Column="1"
                    ItemsSource="{Binding EppOptions}"
                    SelectedItem="{Binding EppOverride, Mode=TwoWay}"
                    MinWidth="125" HorizontalAlignment="Left" Margin="0,0,0,6"
                    IsVisible="{Binding IsEppVisible}"
                    ToolTip.Tip="Enhance Pointer Precision.">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding ., Converter={StaticResource NullableBoolDisplayConverter}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <!-- EPP Override (Registry Curve) row moved here -->
          <!-- Advanced option, hidden by default (Settings > Show EPP Override), see
               AppSettings.ShowEppOverride. Label and content are separate sibling elements
               sharing this Grid.Row (not one container), so both need the binding for the
               row to actually collapse instead of leaving the label behind. -->
          <TextBlock Grid.Row="3" Grid.Column="0" Text="EPP Override:" VerticalAlignment="Center" Margin="0,0,10,6"
                     IsVisible="{Binding IsEppOverrideVisible}" />
          <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,6" VerticalAlignment="Center"
                IsVisible="{Binding IsEppOverrideVisible}">
            <TextBox Grid.Column="0" Classes="value-box"
                     Text="{Binding RegistryCurveString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Watermark="Skip"
                     IsEnabled="{Binding !IsRegAutoSync}"
                     ToolTip.Tip="Registry curve multiplier for EPP." />
            <TextBlock Grid.Column="0" Classes="input-error-icon" Margin="0,0,6,0"
                       IsVisible="{Binding !IsRegistryCurveInputValid}"
                       ToolTip.Tip="Rejected — must be a positive number, at most 15 significant digits." />
            <ToggleButton Grid.Column="1"
                          IsChecked="{Binding IsRegAutoSync, Mode=TwoWay}"
                          Content="Auto" Classes="auto-toggle"
                          IsVisible="{Binding IsAutoSyncAvailable}"
                          ToolTip.Tip="Automatically fine-tune the registry curve to match the Default profile." />
            <TextBlock Grid.Column="2"
                       Classes="match-percent"
                       IsVisible="{Binding !IsDefault}"
                       Text="{Binding MatchAccuracy}"
                       ToolTip.Tip="{Binding MatchAccuracy}" />
          </Grid>
        </Grid>
      </Border>

        <!-- Same class as "Settings" above, no per-instance Margin override; the
             Windows Pointer -> Context gap is the same as every other card-to-card gap on this
             page (from Windows Pointer's own trailing margin), not a distinct "bigger" section
             break value. -->
        <Border Grid.Row="3" Classes="group-header-bar">
          <TextBlock Text="Context" />
        </Border>

            <!-- ═══ Card 1: Auto-Match Environment ═══ -->
            <!-- Moved down into the "Context" group (see this scope's own comment above): only
                 affects the power users who've deliberately enabled it in Settings, since it's
                 hidden by default, so nobody else's experience changes. Advanced option, hidden
                 by default (Settings > Show Auto-Match Environment), see
                 AppSettings.ShowAutoMatchEnvironment. One Border, whole card goes with it. -->
            <Border Grid.Row="4" Classes="card" Padding="14,10" Margin="0,0,0,8"
              IsVisible="{Binding IsAutoMatchEnvironmentVisible}">
        <Grid RowDefinitions="Auto,Auto">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                     Text="Auto-Match Environment" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />

          <!-- MOCKUP: Screen Width/Height combined onto one "Screen Size:" row (was two stacked
               rows), still joins the shared "LabelCol" group via plain Grid.Column="0"
               placement, so it lines up with "Settings:"/"Sensitivity:"/"Pointer Speed:" down
               the page, same as every other row in this file. -->
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Screen Size:" VerticalAlignment="Center" Margin="0,0,10,6" />
          <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="62,Auto,62" HorizontalAlignment="Left" Margin="0,0,0,6">
            <Grid Grid.Column="0">
              <ComboBox IsEditable="True"
                        Classes="editable-centered"
                        Text="{Binding TargetScreenWidthString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding ScreenWidthPresets}"
                        ToolTip.Tip="Target screen width in pixels — doesn't change your actual Windows resolution, only used for the auto-compensation math." />
              <!-- Extra right-margin (vs. the 6px on plain TextBoxes) so the icon clears the
                   ComboBox's own built-in dropdown arrow instead of overlapping it. -->
              <TextBlock Classes="input-error-icon" Margin="0,0,24,0"
                         IsVisible="{Binding !IsTargetScreenWidthInputValid}"
                         ToolTip.Tip="Rejected — must be a positive number." />
            </Grid>
            <!-- A drawn shape, not a text glyph: a text "×" character depends on the font's own
                 advance-width/side-bearing metrics for that specific glyph, which turned out
                 (measured live via pixel-color scanning, not eyeballed) to not be symmetric in
                 this app's font. No combination of Margin/TextAlignment could get it exactly
                 centered, because the leftover space in a fixed 20px gap doesn't split evenly
                 around every possible glyph width. Two crossing Lines from corner to corner of an
                 explicit 8x8 square are symmetric by construction (both lines are exact mirror
                 images of each other), so centering is exact arithmetic (6px margin either side
                 of an 8px shape = 20px total) instead of dependent on font rendering. -->
            <Viewbox Grid.Column="1" Width="8" Height="8" Margin="6,0,6,0" VerticalAlignment="Center">
              <Canvas Width="8" Height="8">
                <Line StartPoint="0,0" EndPoint="8,8" Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1.3" />
                <Line StartPoint="8,0" EndPoint="0,8" Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1.3" />
              </Canvas>
            </Viewbox>
            <Grid Grid.Column="2">
              <ComboBox IsEditable="True"
                        Classes="editable-centered"
                        Text="{Binding TargetScreenHeightString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding ScreenHeightPresets}"
                        ToolTip.Tip="Target screen height in pixels — doesn't change your actual Windows resolution, only used for the auto-compensation math." />
              <TextBlock Classes="input-error-icon" Margin="0,0,24,0"
                         IsVisible="{Binding !IsTargetScreenHeightInputValid}"
                         ToolTip.Tip="Rejected — must be a positive number." />
            </Grid>
          </Grid>
        </Grid>
      </Border>
      </Grid>

            <!-- ═══ Card 4: Target Associations (hidden for Default profile) ═══ -->
            <!-- Width is bound to Card 2 (Raw Accel)'s actual rendered width. Card 4 is a sibling
                 of the "CardWidth" scope above, not a member of it (see that scope's comment for
                 why membership caused a stuck-wide bug), so this binding can only ever consume the
                 already-resolved size, never contribute to or inflate it. -->
            <Border Grid.Row="1" Classes="card" Width="{Binding #RawAccelCard.Bounds.Width}" Padding="14,10" MinHeight="64">
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="App Rules"
                       FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button Content="Manage…"
                    Command="{Binding OpenTargetManagerCommand}"
                    Padding="10,4" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding TargetAssociationsSummary}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:TargetAssociation">
                <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                  <Border Grid.Column="0" Background="{DynamicResource ThemeControlMidBrush}" CornerRadius="0" Padding="5,1" Margin="0,0,6,0">
                    <TextBlock Text="{Binding TypeLabel}" FontSize="10" FontWeight="Bold" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" Opacity="0.8"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Value}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="(no rules)"
                     FontStyle="Italic" Opacity="0.45" FontSize="12"
                     IsVisible="{Binding IsTargetAssociationsEmpty}" />
        </StackPanel>
      </Border>

    </Grid>
  </ScrollViewer>

</UserControl>
