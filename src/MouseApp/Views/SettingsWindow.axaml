<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MouseApp.ViewModels;assembly=MouseApp"
        mc:Ignorable="d"
        x:DataType="vm:SettingsViewModel"
        x:Class="MouseApp.Views.SettingsWindow"
        Title="Settings"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <!-- Same card styling as the Profile Editor page (Border Classes="card", 14,10 padding): each
       group is its own bordered box with a bold settings-section-header at 14px, matching that
       page's card headers, instead of plain text section breaks with no visual container. Gaps
       between cards come from this outer StackPanel's own Spacing, the same mechanism the
       Profile Editor uses between its cards, not a per-block Margin like the old floating-header
       layout needed. -->
  <StackPanel Margin="8" Spacing="8">

    <Border Classes="card" Padding="14,10">
      <StackPanel Spacing="8">
        <TextBlock Text="Folders" Classes="settings-section-header" />
        <StackPanel Spacing="8">
          <TextBlock Text="Raw Accel App Folder" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBox Width="420" Watermark="(default: app folder)" Text="{Binding RawAccelDirectory, Mode=TwoWay}" />
            <Button Content="Browse" Command="{Binding BrowseRawAccelDirCommand}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Spacing="8">
          <TextBlock Text="Raw Accel Presets Folder" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBox Width="420" Watermark="(default: app folder)" Text="{Binding RawAccelSettingsDirectory, Mode=TwoWay}" />
            <Button Content="Browse" Command="{Binding BrowseRawAccelSettingsDirCommand}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" Padding="14,10">
      <StackPanel Spacing="8">
        <TextBlock Text="App Behavior" Classes="settings-section-header" />
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <ToggleSwitch IsChecked="{Binding RunAtStartup, Mode=TwoWay}" />
          <TextBlock Text="Run At Startup" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <ToggleSwitch IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
          <TextBlock Text="Close to Tray" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <ToggleSwitch IsChecked="{Binding StartMinimized, Mode=TwoWay}" />
          <TextBlock Text="Start in Tray" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" Padding="14,10">
      <StackPanel Spacing="8">
        <TextBlock Text="Advanced Profile Editor Options" Classes="settings-section-header" />
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <ToggleSwitch IsChecked="{Binding ShowEpp, Mode=TwoWay}" />
          <TextBlock Text="Show EPP" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <ToggleSwitch IsChecked="{Binding ShowEppOverride, Mode=TwoWay}" />
          <TextBlock Text="Show EPP Override" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <ToggleSwitch IsChecked="{Binding ShowAutoMatchEnvironment, Mode=TwoWay}" />
          <TextBlock Text="Show Auto-Match Environment" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" Padding="14,10">
      <StackPanel Spacing="8">
        <TextBlock Text="Troubleshooting" Classes="settings-section-header" />
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Button Content="Reset Mouse Curve to Windows Default" Command="{Binding RevertCurveCommand}" />
          <TextBlock Text="{Binding RevertCurveStatusMessage}"
                     IsVisible="{Binding IsRevertCurveStatusVisible}"
                     FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Same divider treatment as Target Manager's Cancel/Save row: a top border caps off the
         content above it, so the empty space to these buttons' left reads as a deliberate footer
         area instead of leftover space. -->
    <Border BorderBrush="{DynamicResource ThemeBorderMidBrush}"
            BorderThickness="0,1,0,0"
            Padding="0,8,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Classes="dialog-action" Content="Cancel" Command="{Binding CancelCommand}" />
        <Button Classes="dialog-action" Content="Save" Command="{Binding SaveCommand}" IsDefault="True" />
      </StackPanel>
    </Border>

  </StackPanel>

</Window>
