<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MouseApp.ViewModels;assembly=MouseApp"
             xmlns:models="clr-namespace:MouseApp.Models;assembly=MouseApp"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:converters="clr-namespace:MouseApp.Converters;assembly=MouseApp"
             x:DataType="vm:ProfileEditorViewModel"
             mc:Ignorable="d"
             x:Class="MouseApp.Views.ProfileEditorView">

  <UserControl.Resources>
    <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
    <converters:WinPointerSpeedDisplayConverter x:Key="WinPointerSpeedDisplayConverter" />
    <converters:NullableBoolDisplayConverter x:Key="NullableBoolDisplayConverter" />
    <converters:DpiDisplayConverter x:Key="DpiDisplayConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="ComboBox.editable-centered /template/ TextBox#PART_EditableTextBox">
      <Setter Property="Padding" Value="8,0,0,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon-btn">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ToggleButton.auto-toggle">
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <Style Selector="TextBlock.match-percent">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="{Binding IsAutoSyncAvailable, Converter={StaticResource BoolToOpacityConverter}}" />
    </Style>
  </UserControl.Styles>


  <ScrollViewer Margin="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8" Grid.IsSharedSizeScope="True">

            <!-- ═══ Card 1: Raw Accel ═══ -->
            <Border Grid.Row="0" Classes="card" Width="500" Padding="14,10,6,10">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
          <!-- Header -->
          <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                     Text="Raw Accel" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />

          <!-- Settings row -->
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Settings:" VerticalAlignment="Center" Margin="0,0,10,6" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
            <ComboBox ItemsSource="{Binding RawAccelSettingsFiles}" SelectedItem="{Binding SelectedRawAccelSettingsFile, Mode=TwoWay}" Width="210">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding ., TargetNullValue=(Skip)}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Classes="icon-btn"
                    Command="{Binding OpenRawAccelGuiCommand}"
                    ToolTip.Tip="Open the Raw Accel GUI (rawaccel.exe)">
              <TextBlock Text="🔧" FontSize="14" TextAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Classes="icon-btn"
                    Command="{Binding ImportCurrentSettingsCommand}"
                    ToolTip.Tip="Import current Raw Accel settings.json into the settings library">
              <TextBlock Text="📥" FontSize="14" TextAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Classes="icon-btn"
                    Command="{Binding DuplicateRawAccelSettingsCommand}"
                    ToolTip.Tip="Duplicate selected settings file under a new name">
              <TextBlock Text="⧉" FontSize="14" TextAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Classes="icon-btn"
                    Command="{Binding RenameRawAccelSettingsCommand}"
                    ToolTip.Tip="Rename selected settings file (updates any profiles that reference it)">
              <TextBlock Text="✏" FontSize="14" TextAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Classes="icon-btn"
                    Command="{Binding DeleteRawAccelSettingsCommand}"
                    ToolTip.Tip="Delete selected settings file from library">
              <TextBlock Text="🗑" FontSize="14" TextAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </StackPanel>

          <!-- Sensitivity row -->

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Sensitivity:" VerticalAlignment="Center" Margin="0,0,10,6" />
          <!-- Sensitivity row with Auto and Match % right-aligned -->
          <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,6" VerticalAlignment="Center">
            <TextBox Grid.Column="0"
                     Text="{Binding SensitivityString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="210" Watermark="Skip"
                     IsEnabled="{Binding !IsRawAutoSync}"
                     ToolTip.Tip="Raw Accel sensitivity multiplier. No enforced maximum — Raw Accel's own source places no bound on this field beyond standard double-precision range. Leave blank to skip." />
            <ToggleButton Grid.Column="1"
                          IsChecked="{Binding IsRawAutoSync, Mode=TwoWay}"
                          Content="Auto" Classes="auto-toggle"
                          Opacity="{Binding IsAutoSyncAvailable, Converter={StaticResource BoolToOpacityConverter}}"
                          IsHitTestVisible="{Binding IsAutoSyncAvailable}"
                          ToolTip.Tip="Auto-compute sensitivity to match the Default profile. This row shows how well raw accel sensitivity alone offsets the environmental delta, before Win Speed or Registry Bridge contribute." />
            <TextBlock Grid.Column="2"
                       Classes="match-percent"
                       Text="{Binding RawAccelMatchAccuracy}"
                       ToolTip.Tip="{Binding RawAccelMatchAccuracy}" />
          </Grid>
        </Grid>
      </Border>

            <!-- ═══ Card 3: Windows Pointer ═══ -->
            <Border Grid.Row="1" Classes="card" Width="500" Padding="14,10">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                     Text="Windows Pointer" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Pointer Speed:" VerticalAlignment="Center" Margin="0,0,10,6" />

          <!-- Pointer Speed row with Auto and Match % right-aligned -->
          <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,6" VerticalAlignment="Center">
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding WinPointerOptions}" SelectedItem="{Binding WinPointerSpeed, Mode=TwoWay}"
                      MinWidth="125" IsEnabled="{Binding !IsOSAutoSync}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding ., Converter={StaticResource WinPointerSpeedDisplayConverter}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <ToggleButton Grid.Column="1"
                          IsChecked="{Binding IsOSAutoSync, Mode=TwoWay}"
                          Content="Auto" Classes="auto-toggle"
                          Opacity="{Binding IsAutoSyncAvailable, Converter={StaticResource BoolToOpacityConverter}}"
                          IsHitTestVisible="{Binding IsAutoSyncAvailable}"
                          ToolTip.Tip="Auto-compute Win Pointer Speed to compensate environment delta. This row shows how close Raw Accel + Win Pointer Speed gets you, before the registry bridge." />
            <TextBlock Grid.Column="2"
                       Classes="match-percent"
                       Text="{Binding WinSpeedMatchAccuracy}"
                       ToolTip.Tip="{Binding WinSpeedMatchAccuracy}" />
          </Grid>

          <!-- EPP dropdown: Skip / Enable / Disable -->
          <TextBlock Grid.Row="4" Grid.Column="0" Text="EPP:" VerticalAlignment="Center" Margin="0,0,10,6" />
          <ComboBox Grid.Row="4" Grid.Column="1"
                    ItemsSource="{Binding EppOptions}"
                    SelectedItem="{Binding EppOverride, Mode=TwoWay}"
                    MinWidth="125" HorizontalAlignment="Left" Margin="0,2,0,6"
                    ToolTip.Tip="Enhance Pointer Precision override. Skip = leave system setting unchanged; Enable = force on; Disable = force off.">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding ., Converter={StaticResource NullableBoolDisplayConverter}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <!-- EPP Override (Registry Curve) row moved here -->
          <TextBlock Grid.Row="5" Grid.Column="0" Text="EPP Override:" VerticalAlignment="Center" Margin="0,0,10,6" />
          <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,6" VerticalAlignment="Center">
            <TextBox Grid.Column="0"
                     Text="{Binding RegistryCurveString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="180" Watermark="Skip"
                     IsEnabled="{Binding !IsRegAutoSync}"
                     ToolTip.Tip="Registry curve multiplier for EPP (SmoothMouseCurve). Practical max is roughly 10^11-10^13 (varies with DPI/pointer speed) before internal registry storage overflows. Leave blank to skip." />
            <ToggleButton Grid.Column="1"
                          IsChecked="{Binding IsRegAutoSync, Mode=TwoWay}"
                          Content="Auto" Classes="auto-toggle"
                          Opacity="{Binding IsAutoSyncAvailable, Converter={StaticResource BoolToOpacityConverter}}"
                          IsHitTestVisible="{Binding IsAutoSyncAvailable}"
                          ToolTip.Tip="Auto-compute registry curve to cover exact remainder gap. This row shows the final accuracy after all three compensation layers — 100.00% = exact match with the Default profile." />
            <TextBlock Grid.Column="2"
                       Classes="match-percent"
                       Text="{Binding MatchAccuracy}"
                       ToolTip.Tip="{Binding MatchAccuracy}" />
          </Grid>
        </Grid>
      </Border>

            <!-- ═══ Card 4: Auto-Match Environment ═══ -->
            <Border Grid.Row="2" Classes="card" Width="500" Padding="14,10"
              ToolTip.Tip="This app does not change your Windows resolution or scale. These values are only used for the auto-compensation buttons. The EPP override uses this Scale value at apply-time if set; if left blank it reads your current Windows scale live instead.">
        <Grid RowDefinitions="Auto,Auto,Auto">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                     Text="Auto-Match Environment" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Screen Width:" VerticalAlignment="Center" Margin="0,0,10,6" />
          <ComboBox Grid.Row="1" Grid.Column="1" IsEditable="True"
                    Classes="editable-centered"
                    Text="{Binding TargetScreenWidthString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ItemsSource="{Binding ScreenWidthPresets}"
                    Width="100" HorizontalAlignment="Left" Margin="0,0,0,6"
                    PlaceholderText="Skip"
                    ToolTip.Tip="Target screen width in pixels. Leave blank to skip. Common values: 1280, 1366, 1440, 1920, 2560, 3440, 3840, 5120, 7680." />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Scale:" VerticalAlignment="Center" Margin="0,0,10,6" />
          <ComboBox Grid.Row="2" Grid.Column="1" IsEditable="True"
                    Classes="editable-centered"
                    Text="{Binding TargetLogicalDpiString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ItemsSource="{Binding DpiPresets}"
                    Width="100" HorizontalAlignment="Left" Margin="0,0,0,6"
                    PlaceholderText="Skip"
                    ToolTip.Tip="Windows display scale (found in Display Settings). Type a custom DPI value or pick a preset. Leave blank to skip.">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding ., Converter={StaticResource DpiDisplayConverter}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
      </Border>

            <!-- ═══ Card 5: Target Associations (hidden for Default profile) ═══ -->
            <Border Grid.Row="3" Classes="card" Width="500" Padding="14,10" MinHeight="64">
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Target Associations"
                       FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button Content="Manage Targets…"
                    Command="{Binding OpenTargetManagerCommand}"
                    Padding="10,4" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding TargetAssociationsSummary}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:TargetAssociation">
                <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                  <Border Grid.Column="0" Background="{DynamicResource ThemeControlMidBrush}" CornerRadius="0" Padding="5,1" Margin="0,0,6,0">
                    <TextBlock Text="{Binding TypeLabel}" FontSize="10" FontWeight="Bold" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" Opacity="0.8"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Value}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="(no targets — activates on any window)"
                     FontStyle="Italic" Opacity="0.45" FontSize="12"
                     IsVisible="{Binding IsTargetAssociationsEmpty}" />
        </StackPanel>
      </Border>

    </Grid>
  </ScrollViewer>

</UserControl>
