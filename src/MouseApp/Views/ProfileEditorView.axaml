<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MouseApp.ViewModels;assembly=MouseApp"
             xmlns:models="clr-namespace:MouseApp.Models;assembly=MouseApp"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             x:DataType="vm:ProfileEditorViewModel"
             mc:Ignorable="d"
             x:Class="MouseApp.Views.ProfileEditorView">

  <ScrollViewer Margin="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="8">

      <!-- ═══ Card 1: Raw Accel ═══ -->
      <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
              CornerRadius="6" Padding="14,10">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
          <!-- Header -->
          <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                     Text="Raw Accel" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />

          <!-- Template row -->
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Template:" VerticalAlignment="Center" Margin="0,0,10,6" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
            <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}" Width="200" />
            <Button Content="📥" Padding="6,2" Command="{Binding ImportCurrentSettingsCommand}"
                    ToolTip.Tip="Import current Raw Accel settings.json into template library" />
            <Button Content="⧉"  Padding="6,2" Command="{Binding DuplicateTemplateCommand}"
                    ToolTip.Tip="Duplicate selected template under a new name" />
            <Button Content="🗑"  Padding="6,2" Command="{Binding DeleteTemplateCommand}"
                    ToolTip.Tip="Delete selected template from library" />
          </StackPanel>

          <!-- Import panel (spans both columns) -->
          <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6" Margin="0,0,0,4"
                      IsVisible="{Binding IsImportPanelVisible}">
            <TextBlock Text="Save as:" VerticalAlignment="Center" Width="60" />
            <TextBox Text="{Binding PendingTemplateName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="180" Watermark="template name" />
            <Button Content="Save" Padding="8,2" Command="{Binding ConfirmImportCommand}" />
            <Button Content="✕"    Padding="8,2" Command="{Binding CancelTemplateActionCommand}" />
          </StackPanel>

          <!-- Duplicate panel (spans both columns) -->
          <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6" Margin="0,0,0,4"
                      IsVisible="{Binding IsDuplicatePanelVisible}">
            <TextBlock Text="New name:" VerticalAlignment="Center" Width="60" />
            <TextBox Text="{Binding PendingTemplateName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="180" Watermark="new template name" />
            <Button Content="Save" Padding="8,2" Command="{Binding ConfirmDuplicateCommand}" />
            <Button Content="✕"    Padding="8,2" Command="{Binding CancelTemplateActionCommand}" />
          </StackPanel>

          <!-- Sensitivity + Sync Mode on same row -->
          <TextBlock Grid.Row="3" Grid.Column="0" Text="Sensitivity:" VerticalAlignment="Center" Margin="0,0,10,6" />
          <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
            <TextBox Text="{Binding SensitivityString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="120" Watermark="leave empty to skip"
                     IsReadOnly="{Binding IsRawAutoSync}" />
            <ToggleButton IsChecked="{Binding IsRawAutoSync, Mode=TwoWay}"
                          Content="Auto" Padding="8,2"
                          IsVisible="{Binding IsAutoSyncAvailable}"
                          ToolTip.Tip="Auto-compute sensitivity to match Global Default" />
          </StackPanel>

          <!-- Inline match -->
          <TextBlock Grid.Row="4" Grid.Column="0" Text="Match:" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RawAccelMatchAccuracy}" VerticalAlignment="Center"
                     ToolTip.Tip="How well raw accel sensitivity alone offsets the environmental delta before Win Speed or Registry Bridge contribute" />
        </Grid>
      </Border>

      <!-- ═══ Card 3: Windows Pointer ═══ -->
      <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
              CornerRadius="6" Padding="14,10">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                     Text="Windows Pointer" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Pointer Speed:" VerticalAlignment="Center" Margin="0,0,10,6" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
            <ComboBox ItemsSource="{Binding WinPointerOptions}" SelectedItem="{Binding WinPointerSpeed, Mode=TwoWay}"
                      Width="120" IsEnabled="{Binding !IsOSAutoSync}" />
            <ToggleButton IsChecked="{Binding IsOSAutoSync, Mode=TwoWay}"
                          Content="Auto" Padding="8,2"
                          IsVisible="{Binding IsAutoSyncAvailable}"
                          ToolTip.Tip="Auto-compute Win Pointer Speed to compensate environment delta" />
          </StackPanel>

          <CheckBox Grid.Row="2" Grid.ColumnSpan="2" IsThreeState="True"
                    IsChecked="{Binding EppOverride, Mode=TwoWay}"
                    Content="Enhance Pointer Precision"
                    Margin="0,2,0,6"
                    ToolTip.Tip="Checked = force on, Unchecked = force off, Indeterminate = inherit system setting" />

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Match:" Opacity="0.6" VerticalAlignment="Center" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WinSpeedMatchAccuracy}" VerticalAlignment="Center"
                     ToolTip.Tip="How close Raw Accel + Win Pointer Speed gets you before the registry bridge" />
        </Grid>
      </Border>

      <!-- ═══ Card 4: Registry Bridge ═══ -->
      <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
              CornerRadius="6" Padding="14,10">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                     Text="Registry Bridge" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Curve Override:" VerticalAlignment="Center" Margin="0,0,10,6" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
            <TextBox Text="{Binding RegistryCurveString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="120" Watermark="leave empty to skip"
                     IsReadOnly="{Binding IsRegAutoSync}" />
            <ToggleButton IsChecked="{Binding IsRegAutoSync, Mode=TwoWay}"
                          Content="Auto" Padding="8,2"
                          IsVisible="{Binding IsAutoSyncAvailable}"
                          ToolTip.Tip="Auto-compute registry curve to cover exact remainder gap" />
          </StackPanel>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Full Match:" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MatchAccuracy}" VerticalAlignment="Center"
                     ToolTip.Tip="Final accuracy after all three compensation layers. 100.00% = exact match with Global Default." />
        </Grid>
      </Border>

      <!-- ═══ Card 4: Auto-Match Environment ═══ -->
      <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
              CornerRadius="6" Padding="14,10"
              ToolTip.Tip="These values are used only to select and compensate profiles automatically. MouseApp does not change your Windows resolution or DPI.">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                     Text="Auto-Match Environment" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Screen Width:" VerticalAlignment="Center" Margin="0,0,10,6" />
          <ComboBox Grid.Row="1" Grid.Column="1" IsEditable="True"
                    Text="{Binding TargetScreenWidthString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ItemsSource="{Binding ScreenWidthPresets}"
                    Width="140" HorizontalAlignment="Left" Margin="0,0,0,6"
                    ToolTip.Tip="Target screen width in pixels. Leave empty to inherit from Global Default." />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Logical DPI:" VerticalAlignment="Center" Margin="0,0,10,6" />
          <ComboBox Grid.Row="2" Grid.Column="1" IsEditable="True"
                    Text="{Binding TargetLogicalDpiString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ItemsSource="{Binding DpiPresets}"
                    Width="140" HorizontalAlignment="Left" Margin="0,0,0,6"
                    ToolTip.Tip="Logical DPI (96=100%, 120=125%, 144=150%, 192=200%). Leave empty to inherit from Global Default." />
        </Grid>
      </Border>

      <!-- ═══ Card 5: Target Associations (hidden for Global Default) ═══ -->
                  <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="6" Padding="14,10" MinHeight="64">
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Target Associations"
                       FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button Content="Manage Targets…"
                    Command="{Binding OpenTargetManagerCommand}"
                    Padding="10,4" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding TargetAssociationsSummary}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:TargetAssociation">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                  <Border Background="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}" CornerRadius="3" Padding="5,1">
                    <TextBlock Text="{Binding TypeLabel}" FontSize="10" FontWeight="Bold" />
                  </Border>
                  <TextBlock Text="{Binding Value}" VerticalAlignment="Center" Opacity="0.8" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="(no targets — activates on any window)"
                     FontStyle="Italic" Opacity="0.45" FontSize="12"
                     IsVisible="{Binding IsTargetAssociationsEmpty}" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
