<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MouseApp.ViewModels"
        xmlns:views="using:MouseApp.Views"
        xmlns:models="using:MouseApp.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        SizeToContent="Width"
        Height="625"
        MinHeight="480"
        x:Class="MouseApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="MouseApp">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <vm:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" Padding="8,8,4,8">
            <Grid RowDefinitions="*,Auto">

                <!-- Row 0: All profiles -->
                <Border Grid.Row="0"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        CornerRadius="8"
                        ClipToBounds="True"
                        Padding="0">
                    <Grid RowDefinitions="Auto,*">
                        <TextBox Grid.Row="0"
                                 Text="{Binding SearchText, Mode=TwoWay}"
                                 Watermark="Search profiles..."
                                 Margin="4,4,4,2"
                                 CornerRadius="4" />
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding FilteredProfiles}"
                             SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="Margin" Value="3,1" />
                                <Setter Property="Padding" Value="6,3" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:MouseProfile">
                            <Grid ColumnDefinitions="Auto,Auto,*" Margin="0">
                                <!-- Active indicator dot -->
                                <Ellipse Grid.Column="0"
                                         Width="8" Height="8"
                                         Fill="{DynamicResource MatchIndicatorBrush}"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding IsActive}" />
                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding AutoSwitchEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          ToolTip.Tip="Enable automatic profile switching for this profile"
                                          Margin="0,0,6,0" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding ProfileName}"
                                           FontWeight="{Binding IsGlobalDefault, Converter={StaticResource BoolToFontWeightConverter}}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Stretch"
                                           Background="Transparent"
                                           MinHeight="16"
                                           Padding="0,2"
                                           IsVisible="{Binding !IsEditing}"
                                           DoubleTapped="ProfileName_DoubleTapped" />
                                <TextBox Grid.Column="2"
                                         Text="{Binding ProfileName, Mode=TwoWay}"
                                         IsVisible="{Binding IsEditing}"
                                         Padding="2,4"
                                         VerticalContentAlignment="Center"
                                         VerticalAlignment="Center"
                                         Loaded="ProfileNameEdit_Loaded"
                                         KeyDown="ProfileNameEdit_KeyDown"
                                         LostFocus="ProfileNameEdit_LostFocus" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                    </Grid>
                </Border>

                <!-- Row 1: Action bar -->
                <Grid Grid.Row="1" Margin="0,8,0,0"
                      ColumnDefinitions="*,*,*,*,*,*,*,*">
                    <Grid.Styles>
                        <Style Selector="Button">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="Height" Value="28" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="1,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </Grid.Styles>
                    <Button Grid.Column="0"
                            ToolTip.Tip="Apply selected profile"
                            Command="{Binding ApplySelectedCommand}">
                        <TextBlock Text="▶" FontSize="14"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                    <Button Grid.Column="1"
                            ToolTip.Tip="Set as Global Default"
                            Command="{Binding SetAsDefaultCommand}">
                        <TextBlock Text="🏠" FontSize="14"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                    <Button Grid.Column="2"
                            ToolTip.Tip="Clone selected profile"
                            Command="{Binding CloneProfileCommand}">
                        <TextBlock Text="⧉" FontSize="14"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                    <Button Grid.Column="3" Content="+"
                            FontSize="16" FontWeight="Bold"
                            ToolTip.Tip="Add profile"
                            Command="{Binding AddProfileCommand}" />
                    <Button Grid.Column="4" Content="−"
                            FontSize="16" FontWeight="Bold"
                            ToolTip.Tip="Delete selected profile"
                            Command="{Binding DeleteProfileCommand}" />
                    <Button Grid.Column="5"
                            ToolTip.Tip="Move selected profile up"
                            Command="{Binding MoveProfileUpCommand}">
                        <TextBlock Text="↑" FontSize="14"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                    <Button Grid.Column="6"
                            ToolTip.Tip="Move selected profile down"
                            Command="{Binding MoveProfileDownCommand}">
                        <TextBlock Text="↓" FontSize="14"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                    <Button Grid.Column="7"
                            ToolTip.Tip="Global Settings"
                            Command="{Binding OpenSettingsCommand}">
                        <TextBlock Text="⚙" FontSize="16"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Border Grid.Column="1" Padding="4,8,8,8">
            <views:ProfileEditorView DataContext="{Binding ProfileEditor}" />
        </Border>
    </Grid>

</Window>
