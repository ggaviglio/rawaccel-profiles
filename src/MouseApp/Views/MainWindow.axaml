<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MouseApp.ViewModels"
        xmlns:views="using:MouseApp.Views"
        xmlns:models="using:MouseApp.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="MouseApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="MouseApp">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <vm:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" Padding="8">
            <Grid RowDefinitions="*,Auto">

                <!-- Row 0: All profiles -->
                <Border Grid.Row="0"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        CornerRadius="8"
                        ClipToBounds="True"
                        Padding="0">
                    <ListBox ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="Margin" Value="3,2" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:MouseProfile">
                            <Grid ColumnDefinitions="Auto,Auto,*" Margin="0">
                                <!-- Active indicator dot -->
                                <Ellipse Grid.Column="0"
                                         Width="8" Height="8"
                                         Fill="{DynamicResource MatchIndicatorBrush}"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding IsActive}" />
                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding AutoSwitchEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          ToolTip.Tip="Enable automatic profile switching for this profile"
                                          Margin="0,0,6,0" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding ProfileName}"
                                           FontWeight="{Binding IsGlobalDefault, Converter={StaticResource BoolToFontWeightConverter}}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Stretch"
                                           Background="Transparent"
                                           MinHeight="24"
                                           Padding="0,6"
                                           IsVisible="{Binding !IsEditing}"
                                           DoubleTapped="ProfileName_DoubleTapped" />
                                <TextBox Grid.Column="2"
                                         Text="{Binding ProfileName, Mode=TwoWay}"
                                         IsVisible="{Binding IsEditing}"
                                         Padding="2,4"
                                         VerticalContentAlignment="Center"
                                         VerticalAlignment="Center"
                                         Loaded="ProfileNameEdit_Loaded"
                                         KeyDown="ProfileNameEdit_KeyDown"
                                         LostFocus="ProfileNameEdit_LostFocus" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </Border>

                <!-- Row 1: Action bar -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                    <Button Width="32" Height="28"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="Apply selected profile"
                            Command="{Binding ApplySelectedCommand}">
                        <TextBlock Text="▶" FontSize="12"
                                   Width="32"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                    <Button Width="32" Height="28"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="Set as Global Default"
                            Command="{Binding SetAsDefaultCommand}">
                        <TextBlock Text="🏠" FontSize="14"
                                   Width="32"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                    <Button Width="32" Height="28"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="Clone selected profile"
                            Command="{Binding CloneProfileCommand}">
                        <TextBlock Text="⧉" FontSize="14"
                                   Width="32"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                    <Button Content="+"
                            Width="32" Height="28"
                            FontSize="16" FontWeight="Bold"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="Add profile"
                            Command="{Binding AddProfileCommand}" />
                    <Button Content="−"
                            Width="32" Height="28"
                            FontSize="16" FontWeight="Bold"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="Delete selected profile"
                            Command="{Binding DeleteProfileCommand}" />
                    <Button Width="32" Height="28"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="Move selected profile up"
                            Command="{Binding MoveProfileUpCommand}">
                        <TextBlock Text="↑" FontSize="14"
                                   Width="32"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                    <Button Width="32" Height="28"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="Move selected profile down"
                            Command="{Binding MoveProfileDownCommand}">
                        <TextBlock Text="↓" FontSize="14"
                                   Width="32"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                    <Button Width="32" Height="28"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="Global Settings"
                            Command="{Binding OpenSettingsCommand}">
                        <TextBlock Text="⚙" FontSize="16"
                                   Width="32"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Border Grid.Column="1" Padding="8">
            <ContentControl Content="{Binding CurrentView}" />
        </Border>
    </Grid>

</Window>
