<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MouseApp.ViewModels"
        xmlns:views="using:MouseApp.Views"
        xmlns:models="using:MouseApp.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="MouseApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="MouseApp">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#1E1E1E" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="48" />
                </Grid.RowDefinitions>

                <!-- Top: Profiles list -->
                <ListBox Grid.Row="0" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:MouseProfile">
                            <Grid ColumnDefinitions="Auto,*" Margin="2,0">
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding AutoSwitchEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          ToolTip.Tip="Enable automatic profile switching for this profile"
                                          Margin="0,0,6,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ProfileName}"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           Padding="0,6" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Middle: Add / Delete action bar -->
                <Border Grid.Row="1" Background="#2A2A2A" Padding="4,2">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="+"
                                Width="32" Height="28"
                                FontSize="16" FontWeight="Bold"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip.Tip="Add profile"
                                Command="{Binding AddProfileCommand}" />
                        <Button Content="−"
                                Width="32" Height="28"
                                FontSize="16" FontWeight="Bold"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip.Tip="Delete selected profile"
                                Command="{Binding DeleteProfileCommand}" />
                    </StackPanel>
                </Border>

                <!-- Bottom: Global Settings button -->
                <Button Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Content="Global Settings" Margin="0,4,0,0"
                    Command="{Binding OpenSettingsCommand}" />
            </Grid>
        </Border>

        <!-- Main Content -->
        <Border Grid.Column="1" Padding="12">
            <ContentControl Content="{Binding CurrentView}" />
        </Border>
    </Grid>

</Window>
