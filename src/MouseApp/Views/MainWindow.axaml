<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MouseApp.ViewModels"
        xmlns:views="using:MouseApp.Views"
        xmlns:models="using:MouseApp.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="MouseApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="MouseApp">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.22*" MinWidth="180" MaxWidth="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" Padding="8">
            <Grid RowDefinitions="*,Auto">

                <!-- Row 0: All profiles -->
                <ListBox Grid.Row="0"
                         ItemsSource="{Binding Profiles}"
                         SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:MouseProfile">
                            <Grid ColumnDefinitions="Auto,Auto,*" Margin="2,0">
                                <!-- Active indicator dot -->
                                <Ellipse Grid.Column="0"
                                         Width="8" Height="8"
                                         Fill="{DynamicResource MatchIndicatorBrush}"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding IsActive}" />
                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding AutoSwitchEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          ToolTip.Tip="Enable automatic profile switching for this profile"
                                          Margin="0,0,6,0" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding ProfileName}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Stretch"
                                           Background="Transparent"
                                           MinHeight="24"
                                           Padding="0,6"
                                           IsVisible="{Binding !IsEditing}"
                                           DoubleTapped="ProfileName_DoubleTapped">
                                    <TextBlock.FontWeight>
                                        <Binding Path="IsGlobalDefault">
                                            <Binding.Converter>
                                                <vm:BoolToFontWeightConverter />
                                            </Binding.Converter>
                                        </Binding>
                                    </TextBlock.FontWeight>
                                </TextBlock>
                                <TextBox Grid.Column="2"
                                         Text="{Binding ProfileName, Mode=TwoWay}"
                                         IsVisible="{Binding IsEditing}"
                                         Padding="2,4"
                                         VerticalContentAlignment="Center"
                                         VerticalAlignment="Center"
                                         Loaded="ProfileNameEdit_Loaded"
                                         KeyDown="ProfileNameEdit_KeyDown"
                                         LostFocus="ProfileNameEdit_LostFocus" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Row 1: Action bar — add/delete + settings gear -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                        <Button Content="+"
                                Width="32" Height="28"
                                FontSize="16" FontWeight="Bold"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip.Tip="Add profile"
                                Command="{Binding AddProfileCommand}" />
                        <Button Content="−"
                                Width="32" Height="28"
                                FontSize="16" FontWeight="Bold"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip.Tip="Delete selected profile"
                                Command="{Binding DeleteProfileCommand}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="32" Height="28"
                            Padding="0"
                            ToolTip.Tip="Global Settings"
                            Command="{Binding OpenSettingsCommand}">
                        <TextBlock Text="⚙" FontSize="16"
                                   Width="32"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Border Grid.Column="1" Padding="12">
            <ContentControl Content="{Binding CurrentView}" />
        </Border>
    </Grid>

</Window>
