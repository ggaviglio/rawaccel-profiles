<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MouseApp.ViewModels;assembly=MouseApp"
        xmlns:models="clr-namespace:MouseApp.Models;assembly=MouseApp"
        mc:Ignorable="d"
        x:DataType="vm:TargetManagerViewModel"
        x:Class="MouseApp.Views.TargetManagerWindow"
        Title="Target Manager"
        Width="1080" Height="640"
        MinWidth="700" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

  <Grid RowDefinitions="*,Auto" Margin="12" >

    <!-- ════ Main 3-column pane ════ -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*" Margin="0,0,0,10">

      <!-- LEFT: Active Window Discovery -->
      <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="6">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Active Windows" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Content="⟳ Refresh"
                  Command="{Binding RefreshWindowsCommand}"
                  Padding="8,3" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                CornerRadius="6"
                ClipToBounds="True">
          <ListBox ItemsSource="{Binding ActiveWindows}"
                   SelectedItem="{Binding SelectedWindow, Mode=TwoWay}"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Margin" Value="3,1" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:WindowEntry">
                <Grid ColumnDefinitions="6,*" Margin="0,2">
                  <!-- Green match bar — only visible after Test Match -->
                  <Border Grid.Column="0"
                          Background="{DynamicResource MatchIndicatorBrush}"
                          IsVisible="{Binding IsMatched}"
                          Margin="0,2,5,2"
                          CornerRadius="2" />
                  <StackPanel Grid.Column="1"
                              ToolTip.Tip="{Binding DetailTooltip}">
                    <TextBlock Text="{Binding ExeName}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding TitleDisplay}"
                               FontSize="11"
                               Opacity="0.7"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Grid>

      <!-- CENTER: Action buttons -->
      <StackPanel Grid.Column="1"
                  VerticalAlignment="Center"
                  Spacing="8"
                  Margin="12,0">
        <Button Content="→ Add as EXE"
                Command="{Binding AddAsExeCommand}"
                HorizontalAlignment="Stretch"
                Padding="10,6" />
        <Button Content="→ Add as Path"
                Command="{Binding AddAsPathCommand}"
                HorizontalAlignment="Stretch"
                Padding="10,6" />
        <Button Content="→ Add as Class"
                Command="{Binding AddAsClassCommand}"
                HorizontalAlignment="Stretch"
                Padding="10,6" />
        <Button Content="→ Add as Title"
                Command="{Binding AddAsTitleCommand}"
                HorizontalAlignment="Stretch"
                Padding="10,6" />
      </StackPanel>

      <!-- RIGHT: Current Associations -->
      <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto" RowSpacing="6">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Current Associations" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Content="⚡ Test Match"
                  Command="{Binding TestMatchCommand}"
                  Padding="8,3"
                  ToolTip.Tip="Highlight which open windows these associations would match" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                CornerRadius="6"
                ClipToBounds="True">
          <ListBox ItemsSource="{Binding Associations}"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Margin" Value="3,1" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:TargetAssociation">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,2">
                  <!-- Type badge -->
                  <Border Grid.Column="0"
                          Background="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}"
                          CornerRadius="3"
                          Padding="5,2"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding TypeLabel}"
                               FontSize="10"
                               FontWeight="Bold" />
                  </Border>

                  <!-- Value -->
                  <TextBlock Grid.Column="1"
                             Text="{Binding Value}"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Value}" />

                  <!-- Delete -->
                  <Button Grid.Column="2"
                          Content="✕"
                          Padding="6,2"
                          Margin="6,0,0,0"
                          VerticalAlignment="Center"
                          Command="{Binding $parent[Window].((vm:TargetManagerViewModel)DataContext).RemoveCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <!-- Result: how many open windows matched — shown after Test Match -->
        <TextBlock Grid.Row="2"
                   Text="{Binding MatchSummary}"
                   FontSize="11"
                   Opacity="0.75"
                   TextWrapping="Wrap"
                   IsVisible="{Binding MatchSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </Grid>
    </Grid>

    <!-- ════ Manual entry + Save / Cancel ════ -->
    <Border Grid.Row="1"
            BorderBrush="{DynamicResource SystemBaseHighColor}"
            BorderThickness="0,1,0,0"
            Padding="0,8,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Manual:" VerticalAlignment="Center" Opacity="0.7" />
          <ComboBox ItemsSource="{Binding MatchTypeOptions}"
                    SelectedItem="{Binding SelectedManualType, Mode=TwoWay}"
                    Width="110" />
          <TextBox Text="{Binding ManualValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Width="260"
                   Watermark="Paste EXE name, path, class, or title fragment…" />
          <Button Content="Add"
                  Command="{Binding AddManualCommand}"
                  Padding="16,4" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Cancel" Command="{Binding CancelCommand}" />
          <Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
