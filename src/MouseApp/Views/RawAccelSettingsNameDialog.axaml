<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MouseApp.ViewModels;assembly=MouseApp"
        x:Class="MouseApp.Views.RawAccelSettingsNameDialog"
        x:DataType="vm:RawAccelSettingsNameDialogViewModel"
        Title="{Binding Title}"
        Width="360" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
  <StackPanel Margin="16" Spacing="12">
    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBox Name="NameTextBox"
             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Command="{Binding CancelCommand}" />
      <Button Content="OK" Command="{Binding OkCommand}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
