<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MouseApp.ViewModels;assembly=MouseApp"
        x:Class="MouseApp.Views.RawAccelSettingsNameDialog"
        x:DataType="vm:RawAccelSettingsNameDialogViewModel"
        Title="{Binding Title}"
        Width="360" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="8" Spacing="12">
    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBox x:Name="NameTextBox"
             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Classes="dialog-action" Content="Cancel" Command="{Binding CancelCommand}" />
      <Button Classes="dialog-action" Content="Save" Command="{Binding OkCommand}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
