<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MouseApp.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <SolidColorBrush x:Key="MatchIndicatorBrush" Color="#4CAF50" />
        <!-- Segoe MDL2 Assets, not the newer Segoe Fluent Icons: this app needs to keep working
             on Windows 10, where MDL2 is the icon font guaranteed present (Fluent Icons is
             Windows 11-only). One resource so every icon glyph in the app references the same
             font name instead of repeating the string per element. -->
        <FontFamily x:Key="IconFontFamily">Segoe MDL2 Assets</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <SimpleTheme />

        <!-- App-wide monospace font and window icon, so every window (present and future)
             gets both without repeating them per file. -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Cascadia Code" />
            <Setter Property="Icon" Value="/Assets/avalonia-logo.ico" />
        </Style>

        <!-- Shared look for every card/panel box in the app. Change CornerRadius here
             to test rounded vs. sharp corners everywhere at once. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMidBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <!-- Consistent height/vertical-centering for every ComboBox and TextBox app-wide. -->
        <Style Selector="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- SimpleTheme's own ComboBox template (confirmed against Avalonia's source, v11.3.12,
             src/Avalonia.Themes.Simple/Controls/ComboBox.xaml) leaves its dropdown-arrow
             ToggleButton (Name="toggle") unsized, so it auto-sizes to its 8px arrow Path with no
             explicit Padding, landing at 16px wide in practice. The dropdown popup's own
             ScrollBar (SimpleTheme's ScrollBarThickness) renders at 18px. Found live (measured
             both via UI Automation on a real open dropdown): a real, if small, 2px mismatch
             between the two edges of the same control. Targets the named template part directly,
             the same technique this app already uses for ComboBox.editable-centered's internal
             PART_EditableTextBox, so only the toggle button's width changes; the popup,
             scrollbar, and everything else in the template are untouched. App-wide (not scoped
             to one view) since every ComboBox in this app shares the same SimpleTheme template
             and the same mismatch. -->
        <Style Selector="ComboBox /template/ ToggleButton#toggle">
            <Setter Property="Width" Value="18" />
        </Style>

        <!-- Consistent width for dialog action buttons (Save/Cancel/OK), so they don't
             auto-size to their own label length: a 2-letter "OK" next to a 6-letter
             "Cancel" looked mismatched. 75px matches the standard Windows dialog button width. -->
        <Style Selector="Button.dialog-action">
            <Setter Property="MinWidth" Value="75" />
        </Style>

        <!-- Shared look for every settings-window section header (e.g. "App Behavior",
             "Advanced Profile Editor Options"). The surrounding gap between sections is
             controlled by the section container's own Spacing, not by margin on the header
             itself (a small header-only margin bump was tried and didn't read as a real
             section break next to bulky controls like ToggleSwitch; see CLAUDE.md's styling
             note). -->
        <Style Selector="TextBlock.settings-section-header">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Every symbolic button icon in the app (Play/Home/Copy/Add/Remove/Up/Down/Settings/
             Repair/Download/Edit/Delete/Cancel) renders through this one class instead of ad hoc
             Unicode/emoji characters in the app's own Cascadia Code font. Real, confirmed bug
             this replaces: plain symbol/arrow characters (▶ ↑ ↓ ⧉ ✏ −) aren't guaranteed to be
             optically centered within their own character cell the way a purpose-built icon
             font's glyphs are; found live via zoomed screenshots (Play/Up/Down/Duplicate/Edit
             were all visibly off-center even though HorizontalContentAlignment/
             VerticalContentAlignment="Center" were correctly centering the cell itself). True
             color emoji (🔧 📥 🗑 🏠 originally) didn't have this problem, since they render via
             Segoe UI Emoji, itself a purpose-built centered icon set; but mixing full-color
             emoji next to plain monochrome glyphs was its own inconsistency, so everything now
             goes through one icon font instead of two different fixes for two different button
             styles. Codepoints are verified against Microsoft's own Segoe MDL2 Assets icon list,
             not guessed. -->
        <Style Selector="TextBlock.icon-glyph">
            <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Application.Styles>
</Application>