<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MouseApp.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <SolidColorBrush x:Key="MatchIndicatorBrush" Color="#4CAF50" />
    </Application.Resources>

    <Application.Styles>
        <SimpleTheme />

        <!-- App-wide monospace font. -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Cascadia Code" />
        </Style>

        <!-- Shared look for every card/panel box in the app. Change CornerRadius here
             to test rounded vs. sharp corners everywhere at once. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMidBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <!-- Consistent height/vertical-centering for every ComboBox and TextBox app-wide. -->
        <Style Selector="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Consistent width for dialog action buttons (Save/Cancel/OK), so they don't
             auto-size to their own label length: a 2-letter "OK" next to a 6-letter
             "Cancel" looked mismatched. 75px matches the standard Windows dialog button width. -->
        <Style Selector="Button.dialog-action">
            <Setter Property="MinWidth" Value="75" />
        </Style>

        <!-- Shared look for every settings-window section header (e.g. "App Behavior",
             "Advanced Profile Editor Options"). The surrounding gap between sections is
             controlled by the section container's own Spacing, not by margin on the header
             itself (a small header-only margin bump was tried and didn't read as a real
             section break next to bulky controls like ToggleSwitch; see CLAUDE.md's styling
             note). -->
        <Style Selector="TextBlock.settings-section-header">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Application.Styles>
</Application>